# === Local mock (no Supabase required) ===
# Set true to use in-memory Vietnamese seed data.
# When false, EXPO_PUBLIC_SUPABASE_URL + ANON/PUBLISHABLE key are REQUIRED
# (missing/invalid keys will throw — no silent mock fallback).
EXPO_PUBLIC_MOCK_MODE=false

# === Supabase (shared across Expo apps + Vercel) ===
# Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer legacy anon JWT (eyJ…) OR new publishable key (sb_publishable_…)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias accepted by @ridefood/config:
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NEVER put these in Expo / client bundles:
# SUPABASE_SERVICE_ROLE_KEY=
# EXPO_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=
# sb_secret_...

EXPO_PUBLIC_REALTIME_DRIVER=supabase
EXPO_PUBLIC_TRACKING_WEB_BASE_URL=http://localhost:3000/track
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Payment public keys only (never secrets)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_PAYPAL_CLIENT_ID=
EXPO_PUBLIC_RAZORPAY_KEY_ID=
EXPO_PUBLIC_MYFATOORAH_API_KEY_PUBLIC=

# Branding
EXPO_PUBLIC_BRAND_PRIMARY=#24B8C4
EXPO_PUBLIC_BRAND_SECONDARY=#1BA8B5
EXPO_PUBLIC_BRAND_NAME=GOXE
EXPO_PUBLIC_DEFAULT_LOCALE=vi
EXPO_PUBLIC_DEFAULT_CURRENCY=VND
